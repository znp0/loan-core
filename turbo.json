{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/prisma/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": ["HOST", "PORT", "NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["src/generated/prisma/**"]
    },
    "api-gateway#check-types": {
      "outputs": []
    },
    "db:generate": {
      "outputs": ["src/generated/prisma/**"]
    },
    "db:validate": {
      "cache": false
    }
  },
  "globalPassThroughEnv": ["HOST", "PORT", "NODE_ENV", "DATABASE_URL", "DIRECT_URL"],
  "globalDependencies": [
    ".env",
    "**/.env",
    "packages/typescript-config/*.json",
    "packages/eslint-config/*.js"
  ]
}
