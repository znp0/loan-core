{
  "name": "loan-core",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "eslint . --max-warnings=0 && turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-container-tests.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "prepare": "node .husky/install.mjs",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "db:generate": "turbo run db:generate",
    "db:validate": "turbo run db:validate",
    "secrets:setup": "doppler setup --no-interactive",
    "secrets:pull": "node scripts/pull-env.mjs",
    "test:openapi": "pnpm build && node scripts/test-openapi.mjs",
    "test:services": "node scripts/run-container-tests.mjs --services",
    "test:e2e": "node scripts/run-container-tests.mjs --e2e",
    "test:smoke": "node scripts/run-container-tests.mjs --smoke"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "ajv": "8.20.0",
    "eslint": "10.9.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.6",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
