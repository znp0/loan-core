HOST=127.0.0.1
PORT=3004
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional direct connection for migrations; leave empty to use DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

REPAYMENT_INTERNAL_TOKEN="REPLACE_WITH_A_SHARED_INTERNAL_TOKEN"
