generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LoanStatus {
  ACTIVE
  OVERDUE
  CLOSED
}

model Loan {
  id            String                 @id @default(uuid()) @db.Uuid
  applicationId String                 @unique(map: "loans_application_id_key") @map("application_id") @db.Uuid
  customerId    String                 @map("customer_id") @db.Uuid
  status        LoanStatus             @default(ACTIVE)
  contractId    String?                @map("contract_id") @db.Uuid
  creationHash  String?                @map("creation_hash")
  disbursedAt   DateTime?              @map("disbursed_at") @db.Timestamptz(3)
  closedAt      DateTime?              @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  installments  RepaymentInstallment[]
  payments      Payment[]

  // Partial unique index: at most one ACTIVE or OVERDUE loan per customer; CLOSED loans are excluded.
  @@unique([customerId], map: "uq_customer_active_loan", where: raw("(status = ANY (ARRAY['ACTIVE'::\"LoanStatus\", 'OVERDUE'::\"LoanStatus\"]))"))
  @@index([customerId, status], map: "loans_customer_id_status_idx")
  @@map("loans")
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model RepaymentInstallment {
  id                String            @id @default(uuid()) @db.Uuid
  loanId            String            @map("loan_id") @db.Uuid
  loan              Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  installmentNumber Int               @map("installment_number")
  dueDate           DateTime          @map("due_date") @db.Date
  openingPrincipal  BigInt            @map("opening_principal")
  principalAmount   BigInt            @map("principal_amount")
  interestAmount    BigInt            @map("interest_amount")
  totalAmount       BigInt            @map("total_amount")
  paidPrincipal     BigInt            @default(0) @map("paid_principal")
  paidInterest      BigInt            @default(0) @map("paid_interest")
  status            InstallmentStatus @default(PENDING)
  payment           Payment?

  @@unique([loanId, installmentNumber])
  @@map("repayment_installments")
}

model Payment {
  id              String               @id @default(uuid()) @db.Uuid
  loanId          String               @map("loan_id") @db.Uuid
  loan            Loan                 @relation(fields: [loanId], references: [id], onDelete: Restrict)
  installmentId   String               @unique @map("installment_id") @db.Uuid
  installment     RepaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  key             String               @db.VarChar(128)
  amount          BigInt
  principalAmount BigInt               @map("principal_amount")
  interestAmount  BigInt               @map("interest_amount")
  paidAt          DateTime             @map("paid_at") @db.Timestamptz(3)

  @@unique([loanId, key])
  @@index([loanId, paidAt(sort: Desc), id(sort: Desc)])
  @@map("payments")
}
