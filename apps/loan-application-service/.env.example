HOST=127.0.0.1
PORT=3003
NODE_ENV=development
JWT_SECRET=YOUR_JWT_SIGNING_SECRET
LOAN_PRODUCT_SERVICE_URL=http://127.0.0.1:3002
PRODUCT_INTERNAL_TOKEN=YOUR_PRODUCT_INTERNAL_TOKEN
REPAYMENT_SERVICE_URL=http://127.0.0.1:3004
REPAYMENT_INTERNAL_TOKEN=YOUR_REPAYMENT_INTERNAL_TOKEN

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional direct connection for migrations; leave empty to use DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

JWT_SECRET=YOUR_JWT_SIGNING_SECRET
LOAN_PRODUCT_SERVICE_URL=http://127.0.0.1:3002

APPLICATION_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN

DOCUMENT_STORAGE_PATH=./var/application-documents
