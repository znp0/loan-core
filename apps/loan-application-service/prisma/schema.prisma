generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model application_contacts {
  id                String            @id @db.Uuid
  application_id    String            @db.Uuid
  position          Int
  full_name         String
  relationship      String
  phone             String
  loan_applications loan_applications @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([application_id, phone])
  @@unique([application_id, position])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model application_documents {
  id                String                  @id @db.Uuid
  application_id    String                  @db.Uuid
  type              ApplicationDocumentType
  file_name         String
  content_type      String
  size              Int
  storage_key       String                  @unique
  is_current        Boolean                 @default(true)
  uploaded_at       DateTime                @default(now()) @db.Timestamptz(3)
  loan_applications loan_applications       @relation(fields: [application_id], references: [id])

  @@unique([application_id, type], map: "uq_application_current_document", where: raw("(is_current = true)"))
  @@index([application_id, type, uploaded_at(sort: Desc)])
}

model identity_verifications {
  id                String                     @id @db.Uuid
  application_id    String                     @db.Uuid
  status            IdentityVerificationStatus
  mismatched_fields String[]                   @default([])
  verified_at       DateTime                   @db.Timestamptz(3)
  invalidated_at    DateTime?                  @db.Timestamptz(3)
  created_at        DateTime                   @default(now()) @db.Timestamptz(3)
  loan_applications loan_applications          @relation(fields: [application_id], references: [id])

  @@index([application_id, verified_at(sort: Desc), id(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model loan_applications {
  id                     String                   @id @db.Uuid
  application_number     String                   @unique
  customer_id            String                   @unique(map: "uq_customer_active_application", where: raw("(status = ANY (ARRAY['DRAFT'::\"ApplicationStatus\", 'SUBMITTED'::\"ApplicationStatus\", 'APPROVED'::\"ApplicationStatus\"]))")) @db.Uuid
  product_id             String                   @db.Uuid
  status                 ApplicationStatus        @default(DRAFT)
  requested_amount       BigInt
  term_months            Int
  purpose                String
  full_name              String?
  date_of_birth          DateTime?                @db.Date
  identity_number        String?
  identity_issued_date   DateTime?                @db.Date
  identity_expiry_date   DateTime?                @db.Date
  email                  String?
  phone                  String?
  address_line           String?
  ward                   String?
  district               String?
  province               String?
  employment_type        EmploymentType?
  employer_name          String?
  job_title              String?
  employment_start_date  DateTime?                @db.Date
  monthly_income         BigInt?
  other_monthly_income   BigInt?
  bank_code              String?
  account_number         String?
  account_holder_name    String?
  verification_status    VerificationStatus       @default(UNVERIFIED)
  created_at             DateTime                 @default(now()) @db.Timestamptz(3)
  updated_at             DateTime                 @db.Timestamptz(3)
  application_contacts   application_contacts[]
  application_documents  application_documents[]
  identity_verifications identity_verifications[]
  loan_contracts         loan_contracts[]

  @@index([customer_id, created_at(sort: Desc)])
  @@index([product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model loan_contracts {
  id                          String                                @id @db.Uuid
  application_id              String                                @db.Uuid
  contract_number             String
  version                     Int
  status                      LoanContractStatus                    @default(DRAFT)
  principal_amount            BigInt
  currency                    LoanContractCurrency                  @default(VND)
  term_months                 Int
  annual_interest_rate        Decimal                               @db.Decimal(10, 4)
  interest_calculation_method LoanContractInterestCalculationMethod @default(DECLINING_BALANCE_EQUAL_PRINCIPAL)
  total_interest              BigInt
  total_payable               BigInt
  application_snapshot        Json
  product_snapshot            Json
  schedule_preview            Json
  signed_at                   DateTime?                             @db.Timestamptz(3)
  content_hash                String?
  created_at                  DateTime                              @default(now()) @db.Timestamptz(3)
  updated_at                  DateTime                              @db.Timestamptz(3)
  loan_applications           loan_applications                     @relation(fields: [application_id], references: [id])

  @@unique([application_id, version])
}

enum ApplicationDocumentType {
  ID_FRONT
  ID_BACK
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EmploymentType {
  SALARIED
  SELF_EMPLOYED
  OTHER
}

enum IdentityVerificationStatus {
  PASSED
  FAILED
}

enum LoanContractCurrency {
  VND
}

enum LoanContractInterestCalculationMethod {
  DECLINING_BALANCE_EQUAL_PRINCIPAL
}

enum LoanContractStatus {
  DRAFT
  CUSTOMER_SIGNED
  EFFECTIVE
  VOIDED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}
