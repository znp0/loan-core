HOST=127.0.0.1
APPLICATION_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN
PORT=3002
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional direct connection for migrations; leave empty to use DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
