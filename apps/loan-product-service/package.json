{
  "name": "loan-product-service",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm run build && concurrently --kill-others --names compiler,server \"tsc --project tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "pnpm --filter @repo/http build && pnpm db:generate && tsc --project tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src prisma.config.ts --max-warnings=0",
    "check-types": "pnpm --filter @repo/http build && pnpm db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@repo/http": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.15.3",
    "@types/pg": "8.23.1",
    "concurrently": "9.2.1",
    "eslint": "10.9.1",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  },
  "files": [
    "dist"
  ]
}
