generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id           String @id @default(uuid()) @db.Uuid
  email        String
  fullName     String
  phone        String @unique
  passwordHash String
}
